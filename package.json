{
  "name": "jane-appointments",
  "version": "0.1.0",
  "description": "Unofficial Jane App (jane.app) integration: authenticate against a clinic subdomain with username/password and create appointments via the internal session-authenticated API.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "jane": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "login-check": "tsx src/cli.ts login-check",
    "test": "tsx test/jane.mock.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "jane",
    "janeapp",
    "appointments",
    "scheduling",
    "integration"
  ],
  "license": "MIT",
  "dependencies": {
    "axios": "^1.7.7",
    "axios-cookiejar-support": "^5.0.3",
    "cheerio": "^1.0.0",
    "dotenv": "^16.4.5",
    "tough-cookie": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
