# ---------------------------------------------------------------------------
# Jane App clinic credentials
# ---------------------------------------------------------------------------
# Your clinic's Jane subdomain URL. Either of these forms works:
#   https://yourclinic.janeapp.com
#   yourclinic.janeapp.com
JANE_BASE_URL=https://yourclinic.janeapp.com

# Staff login credentials (the account you'd normally type into the /admin
# sign-in page). NOTE: if this account has 2-Step Verification (MFA) enabled,
# the raw HTTP login will fail — see README.
JANE_USERNAME=you@example.com
JANE_PASSWORD=your-password-here

# Optional: persist the session cookie jar to disk between runs so you don't
# re-login every time. Leave blank to keep the session in memory only.
JANE_SESSION_FILE=.jane-session.json

# Optional: set to "true" to dump raw HTML/JSON responses to debug-*.html
# files when something doesn't parse as expected.
JANE_DEBUG=false
