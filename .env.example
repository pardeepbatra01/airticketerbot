# ---------------------------------------------------------------------------
# Jane App clinic credentials
# ---------------------------------------------------------------------------
# Your clinic's Jane subdomain URL. Either of these forms works:
#   https://yourclinic.janeapp.com
#   yourclinic.janeapp.com
JANE_BASE_URL=https://yourclinic.janeapp.com

# PREFERRED AUTH: paste the `_jane_session` cookie from a logged-in admin
# browser (DevTools → Application → Cookies → <clinic>.janeapp.com). The server
# authenticates as that session, skipping the login form and any MFA challenge.
# Treat it like a password. When set, JANE_USERNAME/JANE_PASSWORD are not needed.
JANE_SESSION_COOKIE=

# FALLBACK AUTH: staff login credentials (the account you'd normally type into
# the /admin sign-in page). NOTE: if this account has 2-Step Verification (MFA)
# enabled, the raw HTTP login will fail — use JANE_SESSION_COOKIE instead.
JANE_USERNAME=you@example.com
JANE_PASSWORD=your-password-here

# Clinic IANA timezone (e.g. America/Toronto). Used to format appointment times
# Jane expects with an offset. Only needed if you pass start times as naive
# ("2026-06-15T14:00:00") or UTC ("...Z") values; offset-tagged ISO strings
# (e.g. "2026-06-15T14:00:00-04:00") are used as-is and need no timezone.
JANE_TIMEZONE=America/Toronto

# Optional: persist the session cookie jar to disk between runs so you don't
# re-login every time. Leave blank to keep the session in memory only.
JANE_SESSION_FILE=.jane-session.json

# Optional: set to "true" to dump raw HTML/JSON responses to debug-*.html
# files when something doesn't parse as expected.
JANE_DEBUG=false

# ---------------------------------------------------------------------------
# Retell webhook server (npm run serve)
# ---------------------------------------------------------------------------
# Port the HTTP server listens on.
PORT=8080
# Shared secret Retell must send as the `x-api-key` header on every request.
# Generate a long random string. If unset, the server rejects all calls.
RETELL_WEBHOOK_SECRET=
